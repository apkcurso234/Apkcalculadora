@charset "utf-8";

:root { --azul: #00f7ff; --azul-claro: #7df9ff; --verde: #00ffae; --roxo: #a855f7; --fundo: #050816; --painel: rgba(13, 22, 49, .72); --borda: rgba(0, 247, 255, .35); --texto-suave: #a4b5db; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

html, body { height: 100%; }

body { min-height: 100vh; font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif; color: rgb(255, 255, 255); background: radial-gradient(circle at 20% 10%, rgb(10, 20, 48) 0%, rgb(5, 8, 22) 55%, rgb(2, 4, 12) 100%); overflow-x: hidden; -webkit-font-smoothing: antialiased; }

#fundo { position: fixed; inset: 0px; width: 100%; height: 100%; z-index: -2; }

#glow { position: fixed; inset: 0px; z-index: -1; pointer-events: none; background: radial-gradient(600px at 15% 20%, rgba(0, 247, 255, 0.1), transparent 60%), radial-gradient(700px at 85% 80%, rgba(168, 85, 247, 0.1), transparent 60%); animation: 8s ease-in-out 0s infinite alternate none running pulsoGlow; }

@keyframes pulsoGlow { 
  0% { opacity: 0.6; transform: scale(1); }
  100% { opacity: 1; transform: scale(1.06); }
}

.app { width: min(100% - 28px, 440px); margin: auto; padding: 32px 0px 24px; position: relative; }

.topo { text-align: center; margin-bottom: 26px; animation: 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0s 1 normal both running subir; }

.topo h1 { color: var(--azul); font-size: clamp(26px, 7vw, 32px); letter-spacing: 4px; font-weight: 800; text-shadow: rgba(0, 247, 255, 0.9) 0px 0px 12px, rgba(0, 247, 255, 0.5) 0px 0px 36px, rgba(0, 247, 255, 0.25) 0px 0px 70px; animation: 3.5s ease-in-out 0s infinite alternate none running brilhoTitulo; }

@keyframes brilhoTitulo { 
  0% { text-shadow: rgba(0, 247, 255, 0.7) 0px 0px 10px, rgba(0, 247, 255, 0.35) 0px 0px 30px; }
  100% { text-shadow: rgb(0, 247, 255) 0px 0px 18px, rgba(0, 247, 255, 0.6) 0px 0px 55px; }
}

.topo p { color: var(--texto-suave); margin-top: 10px; font-size: 14px; letter-spacing: 1px; }

.painel { background: var(--painel); border: 1px solid var(--borda); border-radius: 20px; padding: 22px; margin-bottom: 18px; box-shadow: rgba(0, 247, 255, 0.05) 0px 0px 0px 1px, rgba(0, 0, 0, 0.55) 0px 18px 50px, rgba(0, 247, 255, 0.08) 0px 0px 40px, rgba(0, 247, 255, 0.04) 0px 0px 30px inset; backdrop-filter: blur(14px); position: relative; overflow: hidden; animation: 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0s 1 normal both running subir; }

.painel:nth-of-type(2) { animation-delay: 0.12s; }

.painel::before { content: ""; position: absolute; top: 0px; left: -40%; width: 40%; height: 2px; background: linear-gradient(90deg, transparent, var(--azul), transparent); animation: 4s linear 0s infinite normal none running varrer; }

@keyframes varrer { 
  100% { left: 120%; }
}

@keyframes subir { 
  0% { opacity: 0; transform: translateY(18px) scale(0.98); }
  100% { opacity: 1; transform: translateY(0px) scale(1); }
}

.relogio { text-align: center; }

.hora { font-size: clamp(44px, 13vw, 64px); font-weight: 700; color: var(--azul); letter-spacing: 2px; font-variant-numeric: tabular-nums; text-shadow: rgba(0, 247, 255, 0.9) 0px 0px 14px, rgba(0, 247, 255, 0.45) 0px 0px 40px; }

.data { margin-top: 10px; color: rgb(189, 201, 237); text-transform: capitalize; font-size: 14px; letter-spacing: 0.5px; }

.etiqueta { font-size: 11px; letter-spacing: 4px; color: rgb(160, 182, 233); margin-bottom: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; }

.etiqueta::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--azul); box-shadow: 0 0 10px var(--azul); animation: 1.8s ease-in-out 0s infinite normal none running pulsar; }

@keyframes pulsar { 
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.7); }
}

.tela { width: 100%; height: 92px; border: 1px solid rgb(22, 75, 101); border-radius: 14px; background: linear-gradient(rgb(2, 10, 22), rgb(2, 7, 17)); color: var(--verde); font-size: 36px; font-weight: 600; text-align: right; padding: 16px; margin-bottom: 16px; outline: none; box-shadow: rgba(0, 28, 44, 0.9) 0px 0px 22px inset, rgba(0, 255, 174, 0.08) 0px 0px 18px; font-variant-numeric: tabular-nums; transition: box-shadow 0.3s; letter-spacing: 1px; }

.tela.flash { box-shadow: rgba(0, 255, 174, 0.25) 0px 0px 26px inset, rgba(0, 255, 174, 0.3) 0px 0px 26px; }

.teclas { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }

.teclas button { min-width: 0px; height: 62px; border: 1px solid rgba(36, 75, 117, 0.9); border-radius: 14px; color: rgb(232, 244, 255); background: linear-gradient(rgba(28, 48, 88, 0.95), rgba(16, 30, 58, 0.95)); font-size: 22px; font-weight: 500; cursor: pointer; transition: transform 0.1s, background 0.25s, box-shadow 0.25s, border-color 0.25s; touch-action: manipulation; position: relative; overflow: hidden; -webkit-tap-highlight-color: transparent; }

.teclas button::after { content: ""; position: absolute; inset: 0px; background: radial-gradient(circle, rgba(0, 247, 255, 0.35), transparent 65%); opacity: 0; transition: opacity 0.3s; }

.teclas button:hover::after { opacity: 0.6; }

.teclas button:active { transform: scale(0.92); background: linear-gradient(rgb(10, 139, 166), rgb(8, 108, 133)); box-shadow: rgba(0, 247, 255, 0.55) 0px 0px 24px; border-color: var(--azul); }

.teclas .operador { color: var(--azul); background: linear-gradient(rgba(16, 44, 72, 0.98), rgba(10, 30, 52, 0.98)); font-weight: 600; }

.teclas .limpar { color: rgb(255, 113, 149); font-weight: 700; }

.teclas .limpar:active { background: linear-gradient(rgb(166, 40, 63), rgb(122, 28, 46)); box-shadow: rgba(255, 113, 149, 0.5) 0px 0px 24px; }

.teclas .igual { color: rgb(0, 21, 27); background: linear-gradient(rgb(95, 248, 255), rgb(0, 212, 224)); font-weight: 800; font-size: 24px; border-color: rgba(125, 249, 255, 0.8); box-shadow: rgba(0, 247, 255, 0.35) 0px 0px 20px; }

.teclas .igual:hover { box-shadow: rgba(0, 247, 255, 0.65) 0px 0px 32px; }

.teclas .igual:active { background: linear-gradient(rgb(125, 249, 255), rgb(0, 229, 240)); box-shadow: rgba(0, 247, 255, 0.9) 0px 0px 40px; }

.rodape { text-align: center; color: rgb(95, 113, 158); font-size: 11px; letter-spacing: 2px; padding: 12px 0px; animation: 1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.25s 1 normal both running subir; }

button:focus-visible { outline: 2px solid var(--azul-claro); outline-offset: 3px; }

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
}
